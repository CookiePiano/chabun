    <string name="demo_meeting_title">Weekly delivery meeting</string>
    <string name="demo_driver_speaker">Me</string>
    <string-array name="demo_note_speakers">
        <item>Kim, team lead</item>
        <item>Me</item>
        <item>Park, senior</item>
        <item>Kim, team lead</item>
